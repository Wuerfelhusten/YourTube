<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: settings are backed up, the WebView profile (Google sign-in cookies) never is. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="notify.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="notify.xml" />
    </device-transfer>
</data-extraction-rules>
